---

<section
  id="achievements"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My Recognition</h2>
    <div class="mb-8">
      <FuzzyText 
        client:load
        baseIntensity={0.2} 
        hoverIntensity={hoverIntensity} 
        enableHover={enableHover}
        fontSize="2.5rem"
        color="#ffffff"
        text="Achievements"
      />
    </div>

    <!-- Certifications Section -->
    <div class="mb-12">
      <h3 class="text-2xl font-medium mb-6 border-l-4 border-[var(--sec)] pl-4">Certifications</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {certificates.map((cert) => (
          <AchievementCard 
            client:load
            type="certificate" 
            data={cert} 
          />
        ))}
      </div>
    </div>

    <!-- Hackathons Section -->
    <div class="mb-12">
      <h3 class="text-2xl font-medium mb-6 border-l-4 border-[var(--sec)] pl-4">Hackathons</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {hackathons.map((hack) => (
          <AchievementCard 
            client:load
            type="hackathon" 
            data={hack} 
          />
        ))}
      </div>
    </div>

    <!-- Workshops Section -->
    <div class="mb-12">
      <h3 class="text-2xl font-medium mb-6 border-l-4 border-[var(--sec)] pl-4">Workshops</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {workshops.map((workshop) => (
          <AchievementCard 
            client:load
            type="workshop" 
            data={workshop} 
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .shiny-sec {
    position: relative;
    display: inline-block;
  }
  
  .shiny-sec::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: linear-gradient(
      45deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.05) 25%,
      rgba(255, 255, 255, 0.2) 50%,
      rgba(255, 255, 255, 0.05) 75%,
      rgba(255, 255, 255, 0) 100%
    );
    background-size: 200% 100%;
    background-position: 100% 0;
    animation: shine 3s infinite;
    pointer-events: none;
  }
  
  @keyframes shine {
    to {
      background-position: -100% 0;
    }
  }
</style>

<script>
  // Ensure modal functionality works properly by adding any necessary global handlers
  document.addEventListener('DOMContentLoaded', () => {
    // This helps ensure the React components are fully hydrated
    console.log("Achievements section initialized");
    
    // Add an escape key handler for modals
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        // Find and close any open modals
        const modals = document.querySelectorAll('[role="dialog"]');
        modals.forEach(modal => {
          if (modal.classList.contains('fixed')) {
            // Trigger close button click if present
            const closeBtn = modal.querySelector('button');
            if (closeBtn) closeBtn.click();
          }
        });
      }
    });
  });
</script>