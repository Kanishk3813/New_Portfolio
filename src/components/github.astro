---
import FuzzyText from "../React/FuzzyText";
import { Github as GithubIcon } from "lucide-react";

const hoverIntensity = 0.5;
const enableHover = true;

// You'll need to fetch this data from GitHub API in a production environment
// These are placeholder values for the design
const githubStats = {
  repos: 35,
  stars: 128,
  followers: 45,
  contributions: 1240,
  languages: [
    { name: "JavaScript", percentage: 40, color: "#f7df1e" },
    { name: "TypeScript", percentage: 25, color: "#3178c6" },
    { name: "HTML", percentage: 15, color: "#e34c26" },
    { name: "CSS", percentage: 10, color: "#563d7c" },
    { name: "Python", percentage: 10, color: "#3572A5" }
  ],
  topRepos: [
    { name: "NptelOverflow", stars: 42 },
    { name: "TaskX", stars: 21 },
    { name: "ParseFlow", stars: 17 }
  ]
};
---

<section id="github-stats" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My Contributions</h2>
    <div class="mb-8">
      <FuzzyText 
        client:only="react"
        baseIntensity={0.2} 
        hoverIntensity={hoverIntensity} 
        enableHover={enableHover}
        fontSize="2.5rem"
        color="#ffffff"
        text="GitHub Stats"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Stats Overview -->
      <div class="bg-[#1414149c] p-6 rounded-xl border border-[var(--white-icon-tr)] backdrop-blur-sm relative overflow-hidden group">
        <!-- Animated background glow -->
        <div class="absolute -inset-1 bg-gradient-to-r from-[var(--sec)] to-transparent opacity-0 group-hover:opacity-20 blur-xl transition-all duration-700"></div>
        
        <div class="relative">
          <div class="flex items-center gap-3 mb-6">
            <GithubIcon size={28} className="text-[var(--sec)]" />
            <h3 class="text-2xl font-medium">Overview</h3>
          </div>
          
          <div class="grid grid-cols-2 gap-6">
            <div class="stats-card">
              <span class="text-4xl font-bold text-[var(--white)]">{githubStats.repos}</span>
              <span class="text-[var(--white-icon)]">Repositories</span>
            </div>
            <div class="stats-card">
              <span class="text-4xl font-bold text-[var(--white)]">{githubStats.stars}</span>
              <span class="text-[var(--white-icon)]">Stars</span>
            </div>
            <div class="stats-card">
              <span class="text-4xl font-bold text-[var(--white)]">{githubStats.followers}</span>
              <span class="text-[var(--white-icon)]">Followers</span>
            </div>
            <div class="stats-card">
              <span class="text-4xl font-bold text-[var(--white)]">{githubStats.contributions}</span>
              <span class="text-[var(--white-icon)]">Contributions</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Language Usage -->
      <div class="bg-[#1414149c] p-6 rounded-xl border border-[var(--white-icon-tr)] backdrop-blur-sm relative overflow-hidden group">
        <!-- Animated background glow -->
        <div class="absolute -inset-1 bg-gradient-to-r from-[var(--sec)] to-transparent opacity-0 group-hover:opacity-20 blur-xl transition-all duration-700"></div>
        
        <div class="relative">
          <div class="flex items-center gap-3 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-7 text-[var(--sec)]">
              <path d="m16 18 2-2v-3"></path>
              <path d="M11 18H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1"></path>
              <path d="M12 12V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2"></path>
              <circle cx="17" cy="22" r="1"></circle>
              <path d="M4 10V6a2 2 0 0 1 2-2h2"></path>
            </svg>
            <h3 class="text-2xl font-medium">Languages</h3>
          </div>
          
          <div class="space-y-4">
            {githubStats.languages.map((lang) => (
              <div>
                <div class="flex justify-between text-sm mb-1">
                  <span>{lang.name}</span>
                  <span>{lang.percentage}%</span>
                </div>
                <div class="w-full bg-[#ffffff20] rounded-full h-2.5">
                  <div 
                    class="h-2.5 rounded-full" 
                    style={`width: ${lang.percentage}%; background-color: ${lang.color}`}>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Contribution Map -->
    <div class="mt-8 bg-[#1414149c] p-6 rounded-xl border border-[var(--white-icon-tr)] backdrop-blur-sm relative overflow-hidden group">
      <!-- Animated background glow -->
      <div class="absolute -inset-1 bg-gradient-to-r from-[var(--sec)] to-transparent opacity-0 group-hover:opacity-20 blur-xl transition-all duration-700"></div>
      
      <div class="relative">
        <div class="flex items-center gap-3 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-7 text-[var(--sec)]">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <h3 class="text-2xl font-medium">Contribution Activity</h3>
        </div>
        
        <div class="flex justify-center">
          <!-- This div will be replaced with an actual GitHub contribution graph -->
          <!-- For now, let's create a stylized placeholder -->
          <div class="grid grid-cols-12 gap-1 md:gap-2">
            {Array.from({ length: 12 }).map((_, week) => (
              <div class="grid grid-rows-7 gap-1 md:gap-2">
                {Array.from({ length: 7 }).map((_, day) => {
                  // Random intensity for the placeholder
                  const intensity = Math.floor(Math.random() * 4);
                  const colorClass = 
                    intensity === 0 ? "bg-[#1e2230]" : 
                    intensity === 1 ? "bg-[#5e4491]" : 
                    intensity === 2 ? "bg-[#7d59c5]" : 
                    "bg-[#a476ff]";
                  
                  return <div class={`w-3 h-3 md:w-4 md:h-4 rounded-sm ${colorClass}`}></div>;
                })}
              </div>
            ))}
          </div>
        </div>
        
        <div class="flex justify-center mt-4">
          <div class="flex items-center gap-2 text-sm text-[var(--white-icon)]">
            <span>Less</span>
            <div class="flex gap-1">
              <div class="w-3 h-3 rounded-sm bg-[#1e2230]"></div>
              <div class="w-3 h-3 rounded-sm bg-[#5e4491]"></div>
              <div class="w-3 h-3 rounded-sm bg-[#7d59c5]"></div>
              <div class="w-3 h-3 rounded-sm bg-[#a476ff]"></div>
            </div>
            <span>More</span>
          </div>
        </div>
      </div>
    </div>

    <!-- GitHub embed link for real-time stats -->
    <div class="mt-8 flex justify-center">
      <a
        href="https://github.com/Kanishk3813"
        target="_blank"
        class="flex items-center justify-center gap-2 px-6 py-3 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
      >
        <span class="md:text-lg">View live stats on</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-6"
        >
          <path
            d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .stats-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 0.75rem;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }
  
  .stats-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.1);
  }
</style>