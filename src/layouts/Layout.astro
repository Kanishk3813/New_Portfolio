---
import ClickSparkWrapper from '../React/ClickSparkWrapper';
import Squares from '../React/Squares';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Software Developer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-192x192.png" />
    <meta property="og:title" content="Kanishk Reddy" />
    <meta property="og:description" content="Software Developer" />
    <meta property="og:image" content="./banner.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kanishk Reddy Portfolio" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      />
    </noscript>

    <title>{title}</title>
  </head>
  <body class="bg-[--background] md:px-48 lg:px-20 px-9 relative min-h-screen">
    <!-- Custom Loading Animation -->
    <div id="loading-spinner" class="fixed inset-0 flex flex-col items-center justify-center bg-[--background] z-50">
      <div class="loading-container">
        <div class="grid-spinner">
          <div class="square"></div>
          <div class="square"></div>
          <div class="square"></div>
          <div class="square"></div>
          <div class="square highlight"></div>
          <div class="square"></div>
          <div class="square"></div>
          <div class="square"></div>
          <div class="square"></div>
        </div>
      </div>
      <div class="loading-text">Loading Portfolio...</div>
    </div>

    <div class="fixed inset-0 -z-10 w-full h-full">
      <Squares 
        client:load
        speed={0.5} 
        squareSize={40}
        direction="diagonal"
        borderColor="#222222"
        hoverFillColor="#ffffff"
      />
    </div>
    <div class="relative z-10 opacity-0 transition-opacity duration-500" id="main-content">
      <ClickSparkWrapper client:load >
        <slot />
      </ClickSparkWrapper>
    </div>

    <script>
      // Hide spinner and show content when page is fully loaded
      window.addEventListener('load', () => {
        document.getElementById('loading-spinner').classList.add('fade-out');
        document.getElementById('main-content').classList.add('fade-in');
        
        setTimeout(() => {
          document.getElementById('loading-spinner').style.display = 'none';
        }, 800);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "montserrat",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }

  /* Custom Grid Spinner Styles */
  .loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .grid-spinner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 8px;
    width: 90px;
    height: 90px;
  }

  .square {
    width: 100%;
    height: 100%;
    background-color: #222222;
    border: 1px solid #2a2a2a;
    opacity: 0.3;
    transition: all 0.3s ease;
  }

  .highlight {
    background-color: var(--sec);
    box-shadow: 0 0 15px var(--sec);
    opacity: 1;
  }

  .loading-text {
    margin-top: 20px;
    color: var(--white);
    font-size: 14px;
    letter-spacing: 1px;
    opacity: 0.8;
    font-weight: 300;
  }

  /* Animation for grid spinner */
  @keyframes highlight-square {
    0%, 100% { transform: scale(1); opacity: 0.3; background-color: #222222; box-shadow: none; }
    50% { transform: scale(1.1); opacity: 1; background-color: var(--sec); box-shadow: 0 0 15px var(--sec); }
  }

  .grid-spinner .square:nth-child(1) { animation: highlight-square 2s infinite 0.1s; }
  .grid-spinner .square:nth-child(2) { animation: highlight-square 2s infinite 0.2s; }
  .grid-spinner .square:nth-child(3) { animation: highlight-square 2s infinite 0.3s; }
  .grid-spinner .square:nth-child(4) { animation: highlight-square 2s infinite 0.4s; }
  .grid-spinner .square:nth-child(5) { animation: highlight-square 2s infinite 0.5s; }
  .grid-spinner .square:nth-child(6) { animation: highlight-square 2s infinite 0.6s; }
  .grid-spinner .square:nth-child(7) { animation: highlight-square 2s infinite 0.7s; }
  .grid-spinner .square:nth-child(8) { animation: highlight-square 2s infinite 0.8s; }
  .grid-spinner .square:nth-child(9) { animation: highlight-square 2s infinite 0.9s; }

  .fade-out {
    opacity: 0;
    transition: opacity 0.8s ease-out;
  }

  .fade-in {
    opacity: 1 !important;
  }
</style>